# ============================================================
# JOAccountant Backend — Variables d'environnement
# ============================================================
# Copiez ce fichier vers .env (ou configurez les variables dans Render/Docker).
# Toutes les variables peuvent être surchargées par l'environnement au runtime.

# ─── Profil Spring ───────────────────────────────────────────
# Options: dev, demo, staging, prod, render
#   dev     = PostgreSQL embarqué (Zonky) + logs DEBUG + Swagger UI
#   demo    = dev + seed 4 entreprises fictives + utilisateurs démo
#   staging = PostgreSQL externe + config production-like
#   prod    = PostgreSQL externe + sécurité renforcée + Swagger désactivé
#   render  = PostgreSQL Render + adapté free tier
SPRING_PROFILES_ACTIVE=dev

# ─── Base de données (requis pour staging/prod/render) ──────
# En dev/demo: ignoré (PostgreSQL embarqué Zonky démarre automatiquement)
# En prod/render: connectez-vous à votre PostgreSQL externe
# Format JDBC: jdbc:postgresql://HOST:PORT/DATABASE
DATABASE_URL=jdbc:postgresql://localhost:5432/joaccountant
DB_USERNAME=joaccountant_user
DB_PASSWORD=S3cur3P@ssw0rd!2026
DB_POOL_SIZE=10

# ─── Sécurité JWT ────────────────────────────────────────────
# Minimum 256 bits (32+ caractères). OBLIGATOIRE en prod.
# En dev: un secret par défaut est fourni (non sécurisé).
# Générez un secret: openssl rand -base64 48
APP_JWT_SECRET=x7K9mQ2vR8sL4nP6wJ3hF5tB9cY2gD6eN8aU1iM4oT7rV0xZ

# ─── CORS ───────────────────────────────────────────────────
# Origines autorisées (séparées par virgule). Utilisez * pour tout autoriser (dev seulement).
# En prod: https://votre-frontend.com,https://app.joaccountant.ht
CORS_ALLOWED_ORIGINS=*

# ─── Serveur ────────────────────────────────────────────────
# Port HTTP principal (API + Swagger)
SERVER_PORT=8080
# Port management (actuator health/info/metrics)
# En prod: port séparé pour ne pas exposer l'actuator publiquement
# Sur Render: même port que SERVER_PORT (Render fournit PORT automatiquement)
MANAGEMENT_SERVER_PORT=8081

# ─── Rate Limiting ──────────────────────────────────────────
APP_RATE_LIMIT_ENABLED=true
# Redis pour rate limiting distribué (optionnel — fallback in-memory si désactivé)
APP_RATE_LIMIT_REDIS_ENABLED=false
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=

# ─── Stockage fichiers ─────────────────────────────────────
# Répertoire racine pour les PDF générés, exports CSV, etc.
# En prod: /tmp/joaccountant-storage (disque éphémère Render free tier)
# En dev: ./build/storage-dev
APP_FILE_STORAGE_ROOT=/tmp/joaccountant-storage

# ─── Signature électronique (optionnel) ─────────────────────
# Activer pour signer les factures PDF (Décret 2002 Haïti + DGI 2017)
APP_SIGNATURE_XADES_ENABLED=false
APP_SIGNATURE_KEYSTORE_PATH=/path/to/keystore.p12
APP_SIGNATURE_KEYSTORE_PASSWORD=keystore_password
APP_SIGNATURE_KEY_ALIAS=signing-key
APP_SIGNATURE_KEY_PASSWORD=key_password

# ─── Vérification mots de passe HIBP (optionnel) ───────────
# Vérifie si un mot de passe a été compromis (haveibeenpwned.com API)
APP_PASSWORD_HIBP_ENABLED=false

# ─── OpenTelemetry (optionnel) ──────────────────────────────
# Taux d'échantillonnage des traces (0.0 à 1.0)
OTEL_TRACES_SAMPLER_ARG=0.1

# ─── Flyway ─────────────────────────────────────────────────
SPRING_FLYWAY_ENABLED=true
# Baseline pour bases existantes (premier déploiement)
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# ─── JPA / Hibernate ────────────────────────────────────────
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false

# ─── Module Démos (profil demo seulement) ───────────────────
APP_DEMO_ENABLED=true

# ─── Comptes démo (pré-créés par le seeder) ────────────────
# Email: demo_boutik.lakay@joaccountant.ht    Mot de passe: demo1234
# Email: demo_moise.associes@joaccountant.ht   Mot de passe: demo1234
# Email: demo_espwa.pou.ayiti@joaccountant.ht  Mot de passe: demo1234
# Email: demo_caribbean.textiles@joaccountant.ht Mot de passe: demo1234

# ─── Render spécifique ─────────────────────────────────────
# Render fournit automatiquement la variable PORT
# Pour le profil render: SPRING_PROFILES_ACTIVE=render
# Render fournit aussi DATABASE_URL au format postgres://user:pass@host:port/db
# Le profil render convertit automatiquement vers le format JDBC

# ─── Exemples de configuration par environnement ────────────
#
# Développement local:
#   SPRING_PROFILES_ACTIVE=dev
#   (toutes les autres variables sont optionnelles — defaults intégrés)
#
# Développement avec démos:
#   SPRING_PROFILES_ACTIVE=dev,demo
#
# Production (Render free tier):
#   SPRING_PROFILES_ACTIVE=render
#   DATABASE_URL=jdbc:postgresql://dpg-xxx.render.com:5432/joaccountant
#   DB_USERNAME=joaccountant_user
#   DB_PASSWORD=votre_mot_de_passe_render
#   APP_JWT_SECRET=votre_secret_genere_avec_openssl_rand_base64_48
#   CORS_ALLOWED_ORIGINS=https://votre-frontend.vercel.app
#
# Production (Docker/VPS):
#   SPRING_PROFILES_ACTIVE=prod
#   DATABASE_URL=jdbc:postgresql://db.votre-domaine.com:5432/joaccountant
#   DB_USERNAME=joaccountant_user
#   DB_PASSWORD=S3cur3P@ssw0rd!2026
#   APP_JWT_SECRET=x7K9mQ2vR8sL4nP6wJ3hF5tB9cY2gD6eN8aU1iM4oT7rV0xZ
#   CORS_ALLOWED_ORIGINS=https://app.joaccountant.ht
#   MANAGEMENT_SERVER_PORT=8081
